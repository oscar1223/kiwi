{
  "current": "gpt-4o-mini",
  "profiles": {
    "gpt-4o-mini": {
      "provider": "openai",
      "model": "gpt-4o-mini"
    },
    "claude-sonnet": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5"
    },
    "llama3-local": {
      "provider": "ollama",
