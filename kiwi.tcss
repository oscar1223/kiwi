Screen {
    background: ansi_default;
}

#header {
    height: 1;
    padding: 0 2;
    background: ansi_default;
}

#chat-log {
    height: 1fr;
    padding: 1 2;
    background: ansi_default;
    scrollbar-size: 0 0;
}

#stream-view {
    height: auto;
    max-height: 12;
    padding: 0 2;
    background: ansi_default;
    display: none;
}

#stream-view.-visible {
    display: block;
}

#status-bar {
    height: 1;
    padding: 0 2;
    background: ansi_default;
    display: none;
}

#status-bar.-visible {
    display: block;
}

#input-bar {
    height: auto;
    padding: 0 2 1 2;
    background: ansi_default;
}

#prompt-input {
    border: round #4CAF50;
    background: ansi_default;
}

#prompt-input:focus {
    border: round #7CFC00;
}

#input-hint {
    height: 1;
    padding: 0 1;
}
