Screen {
    background: $background;
}

#header {
    height: 1;
    padding: 0 2;
    background: $background;
}

#chat-log {
    height: 1fr;
    padding: 1 2;
    scrollbar-color: #4CAF50;
    scrollbar-color-hover: #7CFC00;
    scrollbar-color-active: #7CFC00;
}

#status-bar {
    height: 1;
    padding: 0 2;
    display: none;
}

#status-bar.-visible {
    display: block;
}

#input-bar {
    height: auto;
    padding: 0 2 1 2;
}

#prompt-input {
    border: round #4CAF50;
    background: $surface;
}

#prompt-input:focus {
    border: round #7CFC00;
}

#input-hint {
    height: 1;
    padding: 0 1;
}
