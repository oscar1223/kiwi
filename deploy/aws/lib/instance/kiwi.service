[Unit]
Description=Kiwi as a Telegram bot (kiwi serve)
Wants=network-online.target
After=network-online.target

[Service]
User=kiwi
Group=kiwi
WorkingDirectory=/home/kiwi
EnvironmentFile=/etc/kiwi/serve.conf
# "+" runs it as root: it reads the secret and hands it to kiwi in its .env.
ExecStartPre=+/usr/local/bin/kiwi-prepare
ExecStart=/home/kiwi/.local/bin/kiwi serve --cwd ${KIWI_WORKDIR}
Restart=always
RestartSec=10
# SIGTERM cancels the running turn; give it time to save.
TimeoutStopSec=30

# kiwi and whatever the agent launches cannot gain privileges or touch the system.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
